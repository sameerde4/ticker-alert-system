FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/data/hf \
    TRANSFORMERS_CACHE=/data/hf \
    TORCH_HOME=/data/hf

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY alert_service/requirements.txt /tmp/requirements.txt
# Install app deps, then force CPU torch (FinBERT demo — no GPU).
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir --force-reinstall \
         torch --index-url https://download.pytorch.org/whl/cpu

COPY alert_service /app/alert_service
COPY batch_ingest /app/batch_ingest
COPY batch_train /app/batch_train
COPY stream_ingest/data /app/stream_ingest/data
COPY db /app/db
RUN mkdir -p /app/data/lake

WORKDIR /app/alert_service
EXPOSE 8010

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
