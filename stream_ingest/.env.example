# Alpaca Trading API keys from https://app.alpaca.markets/ (Paper is fine)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# delayed_sip = 15-minute delayed full-market SIP (free Basic). iex = live IEX only.
ALPACA_FEED=delayed_sip

# Free Basic allows 30 WebSocket symbols per account. Raise only if your plan allows it.
ALPACA_WS_SYMBOL_LIMIT=30

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_BARS=prices.raw.bars

# Symbol universe: path to one ticker per line, or a comma list. Default is the S&P 500 file.
# SYMBOLS_FILE=data/sp500_symbols.txt
# SYMBOLS=AAPL,MSFT,NVDA

# dry-run prints bars to stdout and does not need Kafka
DRY_RUN=1

# Also poll delayed REST minute bars for symbols beyond the WebSocket cap (covers full S&P 500 on free)
REST_POLL_ENABLED=1
REST_POLL_SECONDS=60
