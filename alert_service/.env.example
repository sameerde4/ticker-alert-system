TICKER_ALERT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticker_alert_db
TICKER_ALERT_APP_PORT=8010
TICKER_ALERT_PRICE_MOVE_THRESHOLD=0.03
TICKER_ALERT_VOLUME_SPIKE_THRESHOLD=2.0
TICKER_ALERT_SENTIMENT_THRESHOLD=25
TICKER_ALERT_NEWS_LOOKBACK_HOURS=72
TICKER_ALERT_FUSION_WINDOW_HOURS=48
TICKER_ALERT_PERPLEXITY_API_KEY=
TICKER_ALERT_PERPLEXITY_MODEL=openai/gpt-5.4-mini
TICKER_ALERT_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
TICKER_ALERT_KAFKA_TOPIC_BARS=prices.raw.bars
TICKER_ALERT_KAFKA_GROUP_ID=ticker-alert-live
TICKER_ALERT_LIVE_WATCHLIST_REFRESH_SECONDS=30
TICKER_ALERT_LAKE_ROOT=
